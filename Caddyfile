:2095 {
    # 1. 优先处理节点流量
    handle_path /ws {
        reverse_proxy 127.0.0.1:32619
    }

    # 2. 无论用户输入 /admin 还是 /app，都直接转发
    # 不使用 handle_path，避免切掉路径导致 s-ui 识别不了
    handle /admin/* {
        reverse_proxy 127.0.0.1:2053
    }

    handle /app/* {
        reverse_proxy 127.0.0.1:2053
    }

    # 3. 兜底转发：如果直接访问域名根目录，也转给面板
    handle {
        reverse_proxy 127.0.0.1:2053
    }
}
