:2095 {
    # 1. 转发给面板本身 (s-ui 默认可能就在 2095，为了不冲突，建议在面板里把面板端口改到 2096)
    # 如果你把面板改到了 2096：
    handle_path /admin/* {
        reverse_proxy 127.0.0.1:2086
    }

    # 2. 转发给节点流量 (WebSocket 路径设为 /ws)
    handle_path /ws {
        reverse_proxy 127.0.0.1:32619
    }

    handle {
        respond "Server is running" 200
    }
}
